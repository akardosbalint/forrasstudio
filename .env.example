# [TODO: Supabase env változók]
# Töltsd ki a Supabase projekt beállításokból, majd add hozzá a Vercel
# projekt environment variables listájához is.
# A SUPABASE_PUBLISHABLE_KEY a nyilvánosan is kiadható "publishable" kulcs
# (sb_publishable_... előtag), NEM a secret/service role kulcs.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Ugyanaz az URL/kulcs, csak a böngésző-oldali (CRM login) kliens számára —
# a NEXT_PUBLIC_ prefix miatt ez a build-be bekerül, publishable kulccsal
# ez biztonságos (RLS védi az adatokat).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# [TODO: CRM adatbázis]
# A CRM domain-tábláit (Lead, pipeline stb.) a Prisma kezeli, a Supabase
# projekt Postgres adatbázisán keresztül (Settings -> Database -> Connection
# string -> URI, "Transaction pooler" vagy direct connection). Lásd
# prisma/schema.prisma és README.
DATABASE_URL=

# Az első CRM-be bejelentkező user, aki ezzel az email címmel jelentkezik be
# (magic link — lásd lent), automatikusan admin jogot kap (bootstrap, hogy
# legyen legalább egy admin szerkesztés nélkül). Utána az admin felületen
# (Phase 6) módosítható a szerepkör-kiosztás. A usert magát manuálisan kell
# létrehozni a Supabase Auth Dashboardban (nincs önregisztráció) — jelenleg
# csak ez az egy: balint@flowcore.hu.
FIRST_ADMIN_EMAIL=

# A publikus (bejelentkezés nélküli) kérdőív- és foglalási linkek ebből az
# alap URL-ből épülnek fel (pl. https://crm.flowcore.hu). Fejlesztésben:
# http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Hány napig érvényes egy kiküldött kérdőív-link, mielőtt lejár (alap: 14).
QUESTIONNAIRE_LINK_TTL_DAYS=14

# A discovery call foglalási szabályok (munkanap, 9-18) ebben az IANA
# időzónában értelmezendők (alap: Europe/Budapest).
CRM_TIMEZONE=Europe/Budapest

# [TODO: Google Calendar integráció]
# Google Cloud Console -> "APIs & Services" -> "Credentials" -> OAuth 2.0
# Client ID (típus: Web application), engedélyezve a Google Calendar API-t.
# GOOGLE_OAUTH_REDIRECT_URI: <NEXT_PUBLIC_APP_URL>/api/google/oauth/callback
# — ezt kell hozzáadni a Cloud Console "Authorized redirect URIs" listájához.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# A Google refresh/access tokenek nyugalmi titkosításához (AES-256-GCM).
# Generáld: `openssl rand -base64 32`
ENCRYPTION_KEY=

# [TODO: Resend env változók]
# Új visszahívás-kérésnél azonnali email-értesítés (lib/notifications.ts).
# RESEND_API_KEY: https://resend.com/api-keys
# NOTIFICATION_EMAIL_FROM: küldő cím — saját, Resendnél igazolt domainen
# (pl. ertesites@flowcore.hu); igazolt domain nélkül csak az
# onboarding@resend.dev teszt-cím működik, éles használatra nem alkalmas.
# NOTIFICATION_EMAIL_TO: ide fut be az értesítés (pl. a stúdió email címe)
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
